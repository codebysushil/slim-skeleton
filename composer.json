{
    "name": "sushilk/slim-skeleton",
    "description": "A Slim Framework skeleton application for rapid development",
    "keywords": [
        "slim",
        "rest",
        "psr7",
        "router",
        "microframework"
    ],
    "type": "project",
    "require": {
        "php": "^8.3",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "ext-json": "*",
        "monolog/monolog": "^3.10",
        "vlucas/phpdotenv": "^5.6",
        "slim/twig-view": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "laravel/pint": "^1.29",
        "symfony/var-dumper": "^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "tomasvotruba/type-coverage": "^2.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Slim\\App\\": "app/"
        }
    },
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "serve": "@php -S localhost:5000 -t public"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
